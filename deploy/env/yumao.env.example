# Runtime
APP_ENV=production
DATABASE_PATH=/var/lib/yumao-agent/yumao.sqlite3
APP_ALLOWED_ORIGINS=https://yumao.shaxiaoguang.eu.cc
SESSION_COOKIE_NAME=yumao_session
BOOKING_TIMEZONE=Asia/Shanghai
BOOKING_CURRENCY_CODE=CNY
BOOKING_CURRENCY_MINOR_UNIT_EXPONENT=2

# Generate three independent random base64url values during deployment.
CSRF_HMAC_SECRET=replace-with-random-base64url
APP_CREDENTIAL_ENCRYPTION_KEYS='{"enc-prod-v1":"replace-with-random-base64url"}'
APP_CREDENTIAL_ENCRYPTION_ACTIVE_KEY_ID=enc-prod-v1
APP_UPSTREAM_FINGERPRINT_KEYS='{"fp-prod-v1":"replace-with-random-base64url"}'
APP_UPSTREAM_FINGERPRINT_ACTIVE_KEY_ID=fp-prod-v1

# Official upstream
UPSTREAM_ORIGIN=https://bdtyg.cugb.edu.cn
UPSTREAM_ITEM_AES_KEY_ASCII=replace-with-16-byte-value
UPSTREAM_ITEM_AES_IV_ASCII=replace-with-16-byte-value
UPSTREAM_GET_USER_INFO_MIN_INTERVAL_MS=500
UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
UPSTREAM_READ_TIMEOUT_SECONDS=5
UPSTREAM_TOTAL_DEADLINE_SECONDS=10
UPSTREAM_MAX_RESPONSE_BYTES=65536
UPSTREAM_RETRY_AFTER_FALLBACK_SECONDS=30
MAX_UPSTREAM_BACKOFF_SECONDS=900
UPSTREAM_LEASE_SAFETY_MARGIN_SECONDS=6
TOKEN_EXPIRING_SOON_WINDOW_SECONDS=604800

# Full production behavior. Only one worker service may use this database.
BOOKING_EXECUTION_ENABLED=true
LIVE_AVAILABILITY_ENABLED=false
AVAILABILITY_SIMULATION_ENABLED=false
